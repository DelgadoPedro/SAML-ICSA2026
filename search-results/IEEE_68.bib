  title={ICSA 2025 - Journal First Track Papers}, 
  year={2025},
  volume={},
  number={},
  pages={xv-xvii},
  abstract={The goal of the Journal First track at ICSA 2025 is to share software architecture research and practice results published in top journals with the broader software architecture community. We invite you to visit the links below to read the full papers. The articles are listed in order of publication.},
  keywords={software architecture;microservice api evolution;cost awareness in cloud-based applications;responsible ai architecture;microservice maintainability;mlops in industrial production;model-driven safety and security;self-adaptive robotics software;foundation model-based agents},
  doi={10.1109/ICSA-C65153.2025.00005},
