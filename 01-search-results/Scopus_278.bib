@ARTICLE{Yao20211010,
	author = {Yao, Sheng and Chen, Kaifang and Wan, Yizhou and Wang, Yulong and Zeng, Lian and Zhu, Fengzhao and Liu, Jia and Yang, Liang and Guo, Xiaodong},
	title = {Treatment of acetabular both column fractures with integrated acetabular quadrilateral surface buttress plate; 应用一体化髋臼四方区阻挡钢板治疗髋臼双柱骨折的疗效分析},
