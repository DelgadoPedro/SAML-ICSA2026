@ARTICLE{Yan2022887,
	author = {Yan, Zeyuan and Tan, Yanyan and Chen, Hongling and Meng, Lili and Zhang, Huaxiang},
	title = {An operator pre-selection strategy for multiobjective evolutionary algorithm based on decomposition},
	year = {2022},
	journal = {Information Sciences},
	volume = {610},
	pages = {887 - 915},
	doi = {10.1016/j.ins.2022.08.039},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85136660186&doi=10.1016%2Fj.ins.2022.08.039&partnerID=40&md5=7f25489734ef2e1a16134d66ebc5a7b5},
	abstract = {Evolutionary algorithms (EAs) are a population-based optimization method that adopts survival-of-the-fittest rules. The performance of EAs can be greatly affected by offspring quality. Many researchers hope to adjust the parameters of evolutionary operators to improve offspring quality, but most current methods are regulated by the feedback model, which does not recognize offspring quality. Instead, it adjusts an operator's search structure dynamically based on its historical performance. In fact, there is a co-evolutionary effect between different operators. An operator will not always produce offspring with the best quality, so the feedback model only selects the best operator in history to generate offspring, which ignores the capacity for co-evolution. In this paper, we propose an operator pre-selection strategy (OPS). First, to ensure operators’ capacity for co-evolution, we construct an operator pool using five operators. Second, we select the best offspring based on the classification and feedback models. Finally, we evaluate the offspring and include it in the evolution. Compared with the traditional feedback model, OPS directly identifies higher-quality offspring. Even if the historical performance of an operator is poor, as long as it can generate excellent offspring, it is selected. Experimental results demonstrate the effectiveness of OPS. © 2022 Elsevier Inc.},
	author_keywords = {Decomposition; Evolutionary algorithm; Multi-objective optimization; Pre-selection strategy},
	keywords = {Evolutionary algorithms; Co-evolution; Feedback model; Historical performance; Multi-Objective Evolutionary Algorithm; Multi-objectives optimization; Multiobjective evolutionary algorithms; Population-based optimization methods; Pre-selection; Pre-selection strategy; Survival-of-the-Fittest; Multiobjective optimization},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

