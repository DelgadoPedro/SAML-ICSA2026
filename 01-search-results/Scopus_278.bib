@ARTICLE{Warnett2026155,
	author = {Warnett, Stephen John and Zdun, Uwe},
	title = {AI-Powered Architecting for Industry 4.0 Cyber-Physical Production Systems: A Novel Approach, Research Problems and Challenges},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15982 LNCS},
	pages = {155 - 168},
	doi = {10.1007/978-3-032-04403-7_15},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016262685&doi=10.1007%2F978-3-032-04403-7_15&partnerID=40&md5=b56851b90844f1eca4de3f875531ad1b},
	abstract = {The integration of artificial intelligence (AI) into software architecture has the potential to greatly support practitioners in architecting machine learning (ML) and reinforcement learning (RL) systems. In the context of Industry 4.0 cyber-physical production systems (CPPSs), this work presents our approach, research problems, and open challenges when designing ML and RL systems and applying AI-powered architecting to enhance automation and reduce manual effort. We describe a novel approach with six advanced contributions: organising architectural design decisions (ADDs) linked to the ML workflow and deployment, extending machine learning operations (MLOps) into reinforcement learning operations (RLOps), introducing formal architectural model development, adding automatic conformance checks, using large language models (LLMs) in RL conformance assessment and creating MLOps and RLOps pipelines using LLMs and a low-code approach. We also describe how earlier contributions in supporting the architecting process could be enhanced using AI. We discuss four further key open research challenges: RL model versioning, the development of RL communication protocols, working with agentic AI, and supporting RL within continuous integration and continuous delivery pipelines. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author_keywords = {artificial intelligence; cyber-physical production systems; machine learning; MLOps; reinforcement learning; RLOps; software architecture; software engineering},
	keywords = {Architecture; Embedded systems; Engineering education; Engineering research; Industry 4.0; Learning systems; Network architecture; Open systems; Software architecture; Cybe-physical production system; Cyber physicals; Machine learning operation; Machine-learning; Production system; Reinforcement learning operation; Reinforcement learnings; Research challenges; Reinforcement learning},
	type = {Conference paper},
