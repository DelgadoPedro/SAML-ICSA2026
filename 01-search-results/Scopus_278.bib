@ARTICLE{Lawand2026354,
	author = {Lawand, Daniel Angelo Esteves and Lam, Lucas Quaresma Medina and Bolgheroni, Roberto Oliveira and Ferreira, Renato Cordeiro and Goldman, Alfredo and Finger, Marcelo},
	title = {Making a Pipeline Production-Ready: Challenges and Lessons Learned in the Healthcare Domain},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15982 LNCS},
	pages = {354 - 362},
	doi = {10.1007/978-3-032-04403-7_30},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016155803&doi=10.1007%2F978-3-032-04403-7_30&partnerID=40&md5=66dee432bbebc920e5e2ec6a3aa87905},
	abstract = {Deploying a Machine Learning (ML) training pipeline into production requires good software engineering practices. Unfortunately, the typical data science workflow often leads to code that lacks critical software quality attributes. This experience report investigates this problem in SPIRA, a project whose goal is to create an ML-Enabled System (MLES) to pre-diagnose insufficiency respiratory via speech analysis. This paper presents an overview of the architecture of the MLES, then compares three versions of its Continuous Training subsystem: from a proof of concept Big Ball of Mud  (v1), to a design pattern-based Modular Monolith  (v2), to a test-driven set of Microservices  (v3). Each version improved its overall extensibility, maintainability, robustness, and resiliency. The paper shares challenges and lessons learned in this process, offering insights for researchers and practitioners seeking to productionize their pipelines. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author_keywords = {Code Quality; Experience Report; Healthcare Domain; Machine Learning Enabled Systems; MLOps; Software Architecture},
	keywords = {Computer software selection and evaluation; Engineering education; Health care; Learning systems; Machine learning; Software design; Software quality; Code quality; Critical software; Experience report; Healthcare domains; Machine learning enabled system; Machine-learning; MLOp; Software engineering practices; Software quality attributes; Work-flows; Software architecture},
