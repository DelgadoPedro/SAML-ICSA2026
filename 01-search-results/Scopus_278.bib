	title = {Deployment of an Artificial Intelligence-Based Well Integrity Monitoring Solution},
	year = {2024},
	pages = {},
	doi = {10.2118/220003-MS},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199468231&doi=10.2118%2F220003-MS&partnerID=40&md5=9b5d47a0587de4486f85d3ff4fc45764},
	abstract = {This paper provides comprehensive insights into deploying and operationalizing an Artificial Intelligence (AI)-based well integrity monitoring solution. The paper's central objective is to present the successful implementation of the advanced monitoring solution, focusing on the insights collected from employing Machine Learning Operations (MLOps) principles within the oil and gas industry. Following a successful Proof of Concept (PoC) phase, the project progressed to developing the Minimum Viable Product (MVP), involving the deployment of selected AI models through stages consisting of live data connection, preprocessing, inferencing, post-processing, suppression rules, and email notification, complemented by the development of a user interface to facilitate visualization and validation of notifications, with user feedback stored in a database for continuous model enhancement. Drawing from the conclusions derived from the project, several key insights are provided. Firstly, the strategic architecture of the MVP emerges as a pivotal factor for transitioning from the PoC phase to the final product. The MVP must be carefully crafted to facilitate rapid learning through iterative user feedback while ensuring technical feasibility and economic viability. Secondly, introducing the "AI factory" concept is identified as a fundamental enabler of efficiency in both model development and deployment process, particularly relevant as project teams expand. Thirdly, incorporating MLOps principles and best practices provides invaluable guidance in constructing a scalable AI solution without pre-existing architecture. Fourthly, integrating the "Human-In-The-Loop" concept underlines the importance of continuous feedback in refining and maintaining the continuous operation of AI solutions. Fifthly, central to user adoption is the emphasis on user experience, with specialized suppression rules and an intuitive user interface pivotal in facilitating user validation of detections. Sixthly, explainable AI methodologies play a crucial role in fostering trust in the tool's performance by explaining the rationale behind AI model decisions. Seventhly, the deployed tool performs robustly detecting annulus leakage incidents with high accuracy and minimal false alarms, significantly reducing engineers’ response time. Eighthly, challenges encountered during the scaling process across different assets, such as data availability and quality variations, were addressed through tailored data pre-processing methods and feature engineering techniques. Ninthly, leveraging expertise in real-time data analytics, the tool was extended to address additional use cases, including automatic leak rate test analysis and liquid loading detection and prediction. Finally, counterfactual explanations for LSTM (Long Short-Term Memory) autoencoder models are introduced. It represents a significant technical advancement and is qualitatively evaluated for its impact on user experience. This paper contributes valuable insights into deploying and operationalizing AI-based well integrity monitoring solutions, with practical implications for industry practitioners. © 2024, Society of Petroleum Engineers.},
	keywords = {Data Analytics; Data handling; Data visualization; Fiber optic sensors; Gas industry; Learning systems; User interfaces; Advanced monitoring; Data connection; Integrity monitoring; Intelligence models; Machine-learning; Oil and Gas Industry; Post-processing; Proof of concept; User feedback; Users' experiences; Iterative methods},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Chen2024364,
	author = {Chen, Tianyi},
	title = {Challenges and Opportunities in Integrating LLMs into Continuous Integration/Continuous Deployment (CI/CD) Pipelines},
	year = {2024},
	pages = {364 - 367},
	doi = {10.1109/AINIT61980.2024.10581784},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199208369&doi=10.1109%2FAINIT61980.2024.10581784&partnerID=40&md5=42ea575a2dca874593c1a546573ee47e},
	abstract = {Large Language Models (LLMs) are powerful neural network models that can perform various language-related tasks by generating natural language conditioned on a given input or prompt. However, LLMs also pose significant challenges and risks for their development, deployment, and maintenance, such as computational cost, error and bias, and ethical and social implications. In this paper, we explore the challenges and opportunities in integrating LLMs into Continuous Integration/Continuous Deployment (CI/CD) pipelines, which are automated workflows that enable the delivery of software products or services in a fast, reliable, and consistent manner. We propose a framework for LLMOps, a specialized branch of MLOps that focuses on the development, deployment, and maintenance of LLMs. We demonstrate the use of LLMOps in a case study, where we integrate a LLM into a CI/CD pipeline for a text summarization task. We evaluate the performance, usage, and feedback of the LLM, and show that the LLM improved its quality and reliability after incorporatingthe human feedback loop. We also discuss the ethical and social implications of deploying LLMs in real-world applications, and provide recommendations and directions for future work. © 2024 IEEE.},
