@ARTICLE{Chakraborty2025128,
	author = {Chakraborty, Amit and Ganguly, Susmita and Das, Saptarshi},
	title = {Architectural Pattern for Implementing XAI as a Service for Container-Orchestrated Machine Learning Model Deployments},
	year = {2025},
	pages = {128 - 149},
	doi = {10.1201/9781003592969-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001250065&doi=10.1201%2F9781003592969-7&partnerID=40&md5=7a9936f6f6dfaab3b75a661c1de9d833},
	abstract = {Machine Learning and related methods of Artificial Intelligence have come a long way from being research-oriented topics and these capabilities are differentiators in a business system. At a scale and diversity of the 5V’s of modern data scenarios, these algorithms often sit at a very critical juncture of the ML-operations pipeline and have to be continuously trained and validated through a continuous flow of new data. One aspect of efficiently using such algorithms is to explain them to various concerned stakeholders, both human and other downstream applications. Explainability is extremely important for auditing and compliance purposes as well. Algorithms such as LIME (Local Interpretable Model Agnostic Explanations) and SHAP (Shapley Additive Explanations) are popular in dealing with explanations for a black box model. While a machine learning algorithm is often deployed as a container in an orchestrated framework, adding an explainable part increases the complexity of the architecture. Often the implementation and deployment logic of such explainable algorithms are model agnostics (like LIME and SHAP). In this paper, we have identified this opportunity and proposed an Ambassador-based Side Car (AbSC) pattern to deploy these models uniformly across varied machine learning deployments. The proposed architecture will show how to use the Ambassador-based Side Car pattern to use an explainability algorithm like LIME as a side car proxy alongside the main machine learning container to be used to explain the output of the algorithm on demand. Security and compliance will be emphasized as these two nonfunctional requirements are amongst the primary reasons why explainability is required for machine learning algorithms. The pattern will help to enhance the reusability and modularity of machine learning deployment architectures by separating explanations from actual model working. This will increase the observability of the overall architecture and contribute towards a more robust microservices-oriented architecture. A comparison with an existing model explainability architecture tightly coupled with the primary model deployment is done, and telemetry is seen to improve. To manage the scope of this paper and focus on building the architecture rather than expanding to cover more surface area, we will limit our discussions to LIME explainability and consider model-specific explanations like Layer wise relevance et al. as future work. © 2025 selection and editorial matter, Aleem Ali, Rajdeep Chakraborty and Nawaf R. Alharbe.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

