@CONFERENCE{Siilasjoki2025217,
	author = {Siilasjoki, Niila and Raatikainen, Mikko and Nurminen, Jukka K.},
	title = {A Design Framework for Cloud-HPC Integration in MLOps},
	year = {2025},
