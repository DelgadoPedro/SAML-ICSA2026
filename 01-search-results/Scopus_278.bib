@ARTICLE{Zhang20232226,
	author = {Zhang, Hailiang and Xie, Chaoyong and Tian, Peng and Zhan, Baishao and Chen, Zailiang and Luo, Wei and Liu, Xuemei},
	title = {Measurement of Soil Organic Matter and Total Nitrogen Based on Visible/Near Infrared Spectroscopy and Data-Driven Machine Learning Method; 基于可见/近红外光谱和数据驱动的机器学习方法测量土壤有机质和总氮},
	year = {2023},
